				float4 tex2DNode14 = tex2D( _TerrainTexture, texCoord25 );
				float2 temp_cast_0 = (( ( tex2DNode14.r * _TerrainLUTRange ) + _TerrainLUTOffset )).xx;
				float temp_output_91_0 = ( 1.0 - _CloudsCoverage );
				float2 uv_CloudsTexture = IN.ase_texcoord2.xy * _CloudsTexture_ST.xy + _CloudsTexture_ST.zw;
